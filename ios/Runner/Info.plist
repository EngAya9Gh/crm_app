    <string>This app needs camera access for take photo to set company logo or user picture.</string>
	<key>FLTEnableImpeller</key>
    <false/>
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
	<key>NSLocationWhenInUseUsageDescription</key>
    <string>This application requires access to your location while in use to save the client's location.</string>
	<key>NSPhotoLibraryUsageDescription</key>
    <string>$(PRODUCT_NAME) The app needs gallery access for select image to set company logo or user picture.</string>
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>$(PRODUCT_NAME) The app needs gallery access for select image to set company logo or user picture.</string>
    <key>UISupportsDocumentBrowser</key>
    <true/>
    <key>LSSupportsOpeningDocumentsInPlace</key>
    <true/>
    <key>UIFileSharingEnabled</key>
    <true/>
